# ==============================================================================
# NexusAgent - Backend Environment Configuration Template
# 复制本文件为 .env 并按实际环境填写：cp .env.example .env
# 注意：切勿将包含真实密钥的 .env 文件提交到代码仓库
# ==============================================================================

# PostgreSQL 数据库配置 (需支持 pgvector 扩展或常规关系存储)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_demo

# Qdrant 向量数据库服务地址 (默认端口 6333)
QDRANT_URL=http://127.0.0.1:6333

# 嵌入模型 / SiliconFlow 服务凭据
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# 安全与认证密钥 (生产环境请务必更换为随机强密钥)
SECRET_KEY=enterprise_agent_platform_super_secret_jwt_key_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
